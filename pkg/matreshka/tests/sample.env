# sample.env: fixture for WithEnvFile precedence tests (see reader_test.go).
# Overrides a field full_config.yaml already sets (APP-INFO_VERSION,
# DATA-SOURCES_POSTGRES_HOST) and sets a field full_config.yaml does not
# (SERVICE-DISCOVERY_MAKOSH-URL), so both override and fill-in behavior get
# exercised.

APP-INFO_VERSION=v9.9.9

DATA-SOURCES_POSTGRES_HOST=envfile-host
SERVICE-DISCOVERY_MAKOSH-URL=envfile:1281
